generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id             String          @id @default(uuid())
  email          String          @unique
  password       String
  name           String?
  role           String          @default("CUSTOMER")
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  inquiries      Inquiry[]
  auditLogs      AuditLog[]
  sessionLogs    SessionLog[]
  notifications  Notification[]

  @@index([email])
  @@index([role])
  @@index([createdAt])
}

model AuditLog {
  id           String   @id @default(uuid())
  action       String
  entityType   String
  entityId     String?
  changes      String?
  beforeState  String?
  afterState   String?
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  vehicleId    String?
  vehicle      Vehicle? @relation(fields: [vehicleId], references: [id])
  inquiryId    String?
  inquiry      Inquiry? @relation(fields: [inquiryId], references: [id])
  ipAddress    String?
  createdAt    DateTime @default(now())

  @@index([userId])
  @@index([entityType])
  @@index([createdAt])
  @@index([vehicleId])
  @@index([inquiryId])
  @@index([action])
  @@index([userId, createdAt])
  @@index([entityType, createdAt])
}

model Vehicle {
  id              String          @id @default(uuid())
  slug            String?         @unique
  make            String
  model           String
  year            Int
  priceKES        Int
  mileage         Int
  bodyType        String
  fuelType        String
  transmission    String
  drivetrain      String
  exteriorColor   String
  interiorColor   String
  engine          String
  vin             String?
  location        String?
  status          String          @default("USED")
  featured        Boolean         @default(false)
  description     String
  imageUrl        String
  images          String
  imagePublicIds  String[]
  viewCount       Int             @default(0)
  isDraft         Boolean         @default(false)
  scheduledAt     DateTime?
  publishedAt     DateTime?
  deletedAt       DateTime?
  soldAt          DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  inquiries       Inquiry[]
  auditLogs       AuditLog[]
  notifications   Notification[]
  softInterests   SoftInterest[]
  reservations   Reservation[]

  @@index([slug])
  @@index([vin])
  @@index([status])
  @@index([featured])
  @@index([isDraft])
  @@index([deletedAt])
  @@index([make, model])
  @@index([status, featured])
  @@index([status, deletedAt])
  @@index([bodyType])
  @@index([fuelType])
  @@index([location])
  @@index([createdAt])
  @@index([priceKES])
  @@index([year])
  @@index([featured, status, deletedAt])
}

model Inquiry {
  id          String   @id @default(uuid())
  name        String
  email       String
  phone       String
  message     String
  vehicleId   String?
  vehicle     Vehicle? @relation(fields: [vehicleId], references: [id])
  userId      String?
  user        User?    @relation(fields: [userId], references: [id])
  status      String   @default("PENDING")
  createdAt   DateTime @default(now())
  auditLogs   AuditLog[]

  @@index([vehicleId])
  @@index([userId])
  @@index([email])
  @@index([phone])
  @@index([status])
  @@index([createdAt])
  @@index([status, createdAt])
}

model SessionLog {
  id              String    @id @default(uuid())
  eventType       String
  userId          String?
  username        String?
  role            String?
  ipAddress       String?
  userAgent       String?
  sessionStart    DateTime?
  sessionEnd      DateTime?
  sessionDuration Int?
  createdAt       DateTime   @default(now())
  user            User?     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([eventType])
  @@index([createdAt])
}

model Notification {
  id          String   @id @default(uuid())
  type        String
  message     String
  read        Boolean  @default(false)
  action      String?
  entityType  String?
  entityId    String?
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  vehicleId   String?
  vehicle     Vehicle? @relation(fields: [vehicleId], references: [id])
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([read])
  @@index([createdAt])
  @@index([vehicleId])
  @@index([type])
  @@index([userId, read])
  @@index([userId, createdAt])
}

model NotifySubscriber {
  id              String   @id @default(uuid())
  name            String
  phone           String
  maxBudget       Int      @default(0)
  intentMake      String?
  intentModel     String?
  intentMaxPrice  Int      @default(0)
  status          String   @default("ACTIVE")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([status])
  @@index([intentMake])
  @@index([createdAt])
}

model SoftInterest {
  id          String   @id @default(uuid())
  name        String
  phone       String
  vehicleId   String
  vehicle     Vehicle  @relation(fields: [vehicleId], references: [id])
  followedUp Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([vehicleId])
  @@index([followedUp])
  @@index([createdAt])
}

model Reservation {
  id              String    @id @default(uuid())
  vehicleId       String
  vehicle         Vehicle   @relation(fields: [vehicleId], references: [id])
  buyerName       String
  buyerPhone      String
  amount          Int       @default(500)
  mpesaReceipt    String?
  checkoutRequestId String?
  status          String    @default("ACTIVE")
  expiresAt       DateTime
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([vehicleId])
  @@index([status])
  @@index([expiresAt])
  @@index([createdAt])
}

model CarMake {
  id        String     @id @default(uuid())
  name      String     @unique
  key       String     @unique
  logoUrl   String?
  models    CarModel[]
  createdAt DateTime   @default(now())
}

model Settings {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CarModel {
  id            String   @id @default(uuid())
  makeId        String
  make          CarMake  @relation(fields: [makeId], references: [id])
  name          String
  yearStart     Int
  yearEnd       Int?
  bodyTypes     String
  fuelTypes     String
  transmissions String
  engines       String
  createdAt     DateTime @default(now())

  @@unique([makeId, name, yearStart])
}
